# Project Sentinel — Environment Variables
# Copy this file to .env and fill in your values

# App
DEBUG=true
APP_NAME="Project Sentinel"

# Database (SQLite for local dev — no setup needed!)
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db

# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sentinel

# Optional AI APIs (app works without these using built-in intelligence)
OPENAI_API_KEY=your_openai_api_key_here
SHODAN_API_KEY=your_shodan_api_key_here

# Security
SECRET_KEY=change-this-in-production-to-a-random-64-char-string
